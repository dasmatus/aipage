{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "lib": ["ES2020", "DOM"],
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react-jsx",
        "types": ["bun-types", "chrome", "playwright-core"],
        "moduleResolution": "bundler"
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "build.ts"
    ]
}