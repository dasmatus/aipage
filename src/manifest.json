{
  "manifest_version": 3,
  "name": "AIPage",
  "version": "1.1",
  "description": "EduPage AI for the rest of us with some neat features.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.edupage.org/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.mistral.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.edupage.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.html",
        "sidebar.css",
        "sidebar.js"
      ],
      "matches": [
        "*://*.edupage.org/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open AI Sidebar"
  }
}