{
    "name": "edupage-ai-sidebar",
    "version": "1.3.0",
    "packageManager": "bun@1.3.8",
    "description": "AI Sidebar for EduPage",
    "repository": {
        "type": "git",
        "url": "https://gitlab.com/TenTypekMatus/aipage.git"
    },
    "scripts": {
        "build": "bun run build.ts --target=chrome",
        "build:chrome": "bun run build.ts --target=chrome",
        "build:firefox": "bun run build.ts --target=firefox",
        "build:safari": "bun run build.ts --target=safari",
        "build:all": "bun run build:chrome && bun run build:firefox && bun run build:safari",
        "package:chrome": "cd dist-chrome && zip -r ../edupage-ai-sidebar-chrome.zip .",
        "package:firefox": "npx web-ext build -s dist-firefox -a packages",
        "lint": "eslint 'src/**/*.{ts,tsx}' --quiet",
        "test": "bun run build && npx playwright test",
        "test:all": "bun run build:all && npx playwright test",
        "release": "standard-version",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as major",
        "docs:build": "./scripts/build-docs.sh",
        "docs:api": "typedoc --out public/api src",
        "docs:serve": "mdbook serve --open"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@playwright/test": "^1.58.1",
        "@types/bun": "^1.3.8",
        "@types/chrome": "^0.0.260",
        "@types/eslint": "^9.6.1",
        "@types/marked": "^5.0.2",
        "@types/node": "^25.2.1",
        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@types/webextension-polyfill": "^0.12.1",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "eslint": "^9.39.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^17.3.0",
        "marked": "^17.0.1",
        "sass": "^1.97.3",
        "standard-version": "^9.5.0",
        "typedoc": "^0.27.0",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.54.0",
        "web-ext": "^8.4.0"
    },
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tesseract.js": "^7.0.0",
        "webextension-polyfill": "^0.12.0"
    }
}
