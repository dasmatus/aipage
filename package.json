{
    "name": "edupage-ai-sidebar",
    "version": "1.7.2",
    "packageManager": "bun@1.3.8",
    "description": "AI Sidebar for EduPage (Rust/WASM extension)",
    "repository": {
        "type": "git",
        "url": "https://codeberg.org/dasmatus/aipage.git"
    },
    "scripts": {
        "build": "cargo run -p xtask -- build --target chrome",
        "build:chrome": "cargo run -p xtask -- build --target chrome",
        "build:firefox": "cargo run -p xtask -- build --target firefox",
        "build:safari": "cargo run -p xtask -- build --target safari",
        "build:all": "cargo run -p xtask -- build-all",
        "package:chrome": "cd dist-chrome && zip -r ../aipage-chrome.zip .",
        "package:firefox": "bunx web-ext build -s dist-firefox -a packages",
        "package:safari": "cd dist-safari && zip -r ../aipage-safari.zip .",
        "lint": "cargo clippy --workspace --all-targets",
        "test": "cargo test --workspace",
        "test:e2e": "env -u LD_PRELOAD playwright test",
        "test:e2e:headed": "env -u LD_PRELOAD playwright test --headed",
        "release": "standard-version",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as major",
        "docs:build": "./scripts/build-docs.sh",
        "docs:serve": "mdbook serve --open"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.0",
        "@types/bun": "^1.4.2",
        "autoprefixer": "^10.6.1",
        "postcss": "^8.5.6",
        "postcss-cli": "^11.0.1",
        "sass": "^1.97.3",
        "standard-version": "^9.5.0",
        "tailwindcss": "4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "web-ext": "^8.10.0"
    }
}
