{
    "name": "edupage-gemini-sidebar",
    "version": "1.1.0",
    "packageManager": "bun@1.3.8",
    "description": "Vercel-style Multi-Provider AI Sidebar for EduPage with Anti-Cheat",
    "scripts": {
        "build": "bun run build.ts --target=chrome",
        "build:chrome": "bun run build.ts --target=chrome",
        "build:firefox": "bun run build.ts --target=firefox",
        "build:safari": "bun run build.ts --target=safari",
        "build:all": "bun run build:chrome && bun run build:firefox && bun run build:safari",
        "package:chrome": "cd dist-chrome && zip -r ../edupage-ai-sidebar-chrome.zip .",
        "package:firefox": "npx web-ext build -s dist-firefox -a packages",
        "lint": "eslint 'src/**/*.{ts,tsx}' --quiet",
        "test": "bun run build && npx playwright test --reporter=list"
    },
    "devDependencies": {
        "@types/bun": "^1.3.8",
        "@eslint/js": "^9.39.2",
        "@playwright/test": "^1.58.1",
        "@types/chrome": "^0.0.260",
        "@types/eslint": "^9.6.1",
        "@types/marked": "^5.0.2",
        "@types/node": "^25.2.1",
        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "eslint": "^9.39.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^17.3.0",
        "sass": "^1.97.3",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.54.0",
        "web-ext": "^8.4.0"
    },
    "dependencies": {
        "marked": "^17.0.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "webextension-polyfill": "^0.12.0"
    }
}
