{
  "manifest_version": 2,
  "name": "AIPage",
  "version": "1.7.1",
  "description": "AIPage for the rest of us with some neat features.",
  "permissions": [
    "storage",
    "activeTab",
    "*://*.edupage.org/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://ollama.com/*",
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://auth.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.duckduckgo.com/*",
    "downloads",
    "alarms",
    "notifications",
    "identity"
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; object-src 'self'; connect-src 'self' https://ollama.com https://openrouter.ai https://api.openai.com https://auth.openai.com https://api.anthropic.com https://*.edupage.org https://api.github.com https://github.com https://objects.githubusercontent.com https://api.duckduckgo.com",
  "background": {
    "scripts": ["background.js", "background_loader.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.edupage.org/*"
      ],
      "js": [
        "content.js",
        "content_loader.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    "sidebar.html",
    "sidebar.css",
    "tailwind.css",
    "sidebar.js",
    "sidebar_loader.js",
    "sidebar_bg.wasm",
    "content_bg.wasm",
    "anti_cheat.js"
  ],
  "browser_action": {
    "default_title": "Open AI Sidebar"
  }
}
