{
    "name": "edupage-ai-sidebar",
    "version": "1.7.2",
    "packageManager": "bun@1.3.8",
    "description": "AI Sidebar for EduPage (Rust/WASM extension)",
    "repository": {
        "type": "git",
        "url": "https://github.com/dasmatus/aipage.git"
    },
    "scripts": {
        "build": "cargo run -p xtask -- build --target chrome",
        "build:chrome": "cargo run -p xtask -- build --target chrome",
        "build:firefox": "cargo run -p xtask -- build --target firefox",
        "build:safari": "cargo run -p xtask -- build --target safari",
        "build:all": "cargo run -p xtask -- build-all",
        "package:chrome": "cd dist-chrome && zip -r ../aipage-chrome.zip .",
        "package:firefox": "bunx web-ext build -s dist-firefox -a packages",
        "package:safari": "cd dist-safari && zip -r ../aipage-safari.zip .",
        "lint": "cargo clippy --workspace --all-targets",
        "test": "cargo test --workspace",
        "test:e2e": "env -u LD_PRELOAD playwright test",
        "test:e2e:headed": "env -u LD_PRELOAD playwright test --headed",
        "test:install": "env -u LD_PRELOAD playwright test -c playwright.install.config.ts",
        "test:install:chromium": "env -u LD_PRELOAD playwright test -c playwright.install.config.ts chromium",
        "test:install:firefox": "env -u LD_PRELOAD playwright test -c playwright.install.config.ts firefox",
        "test:install:structure": "env -u LD_PRELOAD playwright test -c playwright.install.config.ts structure",
        "docs:build": "mdbook build && cp book/vercel.json book/book/vercel.json",
        "docs:serve": "mdbook serve --open",
        "changelog": "bash scripts/changelog.sh"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/bun": "^1.4.2",
        "autoprefixer": "^10.6.1",
        "postcss": "^8.5.28",
        "postcss-cli": "^12.0.0",
        "sass": "^1.105.1",
        "tailwindcss": "4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "web-ext": "^10.7.0",
        "@tailwindcss/postcss": "^4.3.3"
    }
}
